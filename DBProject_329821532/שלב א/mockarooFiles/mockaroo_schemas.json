{
  "project": "College Manpower & HR Management System (JCT)",
  "submitter_id": "329821532",
  "version": "2.0",
  "schemas": [
    {
      "schema_name": "Employee_Schema",
      "target_table": "Employee",
      "num_rows": 500,
      "description": "Mockaroo configuration to generate 500 college employees (IDs 1-500)",
      "columns": [
        {
          "name": "EmployeeID",
          "type": "Row Number",
          "formula": null
        },
        {
          "name": "FirstName",
          "type": "First Name",
          "formula": null
        },
        {
          "name": "LastName",
          "type": "Last Name",
          "formula": null
        },
        {
          "name": "ID_Number",
          "type": "Regular Expression",
          "value": "32900[0-9]{4}",
          "formula": null
        },
        {
          "name": "HireDate",
          "type": "Date",
          "min": "01/01/2012",
          "max": "10/01/2026",
          "format": "%Y-%m-%d"
        },
        {
          "name": "BaseSalary",
          "type": "Number",
          "min": 8500.00,
          "max": 42000.00,
          "decimals": 2
        },
        {
          "name": "DepartmentID",
          "type": "Custom List",
          "values": [
            "101", "102", "103", "104", "105", "106",
            "107", "108", "109", "110", "111", "112"
          ]
        },
        {
          "name": "EmployeeType",
          "type": "Formula",
          "formula": "if this <= 250 then 'Administrative' else 'Academic' end"
        }
      ]
    },
    {
      "schema_name": "AdministrativeStaff_Schema",
      "target_table": "AdministrativeStaff",
      "num_rows": 250,
      "description": "Mockaroo configuration for administrative staff (IDs 1-250)",
      "columns": [
        {
          "name": "EmployeeID",
          "type": "Row Number",
          "formula": null
        },
        {
          "name": "OfficeNumber",
          "type": "Template",
          "template": "{{random('Lev','Shalom','Tech','Academic')}}-Rm{{random(101,450)}}"
        },
        {
          "name": "ManagementLevel",
          "type": "Custom List",
          "values": ["Entry", "Junior", "Mid", "Senior", "Director", "Head of Administration"]
        }
      ]
    },
    {
      "schema_name": "AcademicStaff_Schema",
      "target_table": "AcademicStaff",
      "num_rows": 250,
      "description": "Mockaroo configuration for academic staff (IDs 251-500)",
      "columns": [
        {
          "name": "EmployeeID",
          "type": "Formula",
          "formula": "this + 250"
        },
        {
          "name": "ResearchField",
          "type": "Custom List",
          "values": [
            "Algorithms and Artificial Intelligence",
            "Quantum Computing and Information Theory",
            "Electro-Optics, Lasers and Photonics",
            "Biomedical Signal and Image Processing",
            "Supply Chain and Operations Research",
            "Genomics, Proteomics and Bioinformatics",
            "Cloud Systems, Microservices and DevOps",
            "Cybersecurity, Cryptography and Privacy",
            "Computer Vision and Deep Learning",
            "Applied Mathematics and Numerical Modeling",
            "Embedded Systems and IoT Architecture",
            "Nanotechnology and Advanced Materials",
            "Renewable Energy and Smart Grid Systems",
            "Natural Language Processing and Linguistics",
            "Robotics and Autonomous Systems",
            "VLSI Design and Microelectronics"
          ]
        },
        {
          "name": "TenureStatus",
          "type": "Custom List",
          "values": ["Tenured", "Tenure-Track", "Adjunct", "Visiting Professor", "Emeritus"]
        }
      ]
    }
  ]
}